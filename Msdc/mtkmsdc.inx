; MediaTek MT6768 MSDC0/eMMC and MSDC1/microSD SDPORT miniport for Barley.
; This binds only to the vendor ACPI ID.  MT6768 MSDC is not SDHCI/SDA and
; must never be advertised with the standard-compatible PNP0D40 ID.

[Version]
Signature="$Windows NT$"
Class=SDHost
ClassGUID={a0a588a4-c46f-4b37-b7ea-c82fe89870c6}
Provider=%ProviderName%
DriverVer=09/07/2026,0.28.0.0
CatalogFile=mtkmsdc.cat
PnpLockdown=1

[SourceDisksNames]
1=%DiskName%

[SourceDisksFiles]
mtkmsdc.sys=1

[DestinationDirs]
DriverCopyFiles=12

[Manufacturer]
%ManufacturerName%=MediaTek,NTarm64.10.0

[MediaTek.NTarm64.10.0]
%Msdc.DeviceDesc%=Msdc_Install,ACPI\MTK6768

[Msdc_Install]
CopyFiles=DriverCopyFiles

[Msdc_Install.HW]
AddReg=Msdc_Hardware

[Msdc_Hardware]
HKR,,Driver,,"mtkmsdc.sys"
HKR,,UINumberDescFormat,,%SlotDescription%

[Msdc_Install.Services]
AddService=mtkmsdc,0x00000002,Msdc_Service

[Msdc_Service]
DisplayName=%Msdc.ServiceDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\mtkmsdc.sys
LoadOrderGroup=System Bus Extender
BootFlags=0x00000008
AddReg=Msdc_ServiceParameters

; SDPORT reads these from the HOST service RegistryPath, not sdstor.
; Standard Microsoft SDHC sample command permissions; not card-specific
; response data or a bypass of hardware completion/error reporting.
[Msdc_ServiceParameters]
HKR,Parameters,SdCmdFlags,1,    05,01, 06,01, 08,11, 09,19, 0A,19, 0D,11, \
                                10,01, 11,01, 12,01, 17,01, 18,05, 19,05, \
                                1A,01, 1B,01, 1C,01, \
                                20,05, 21,05, 26,05, \
                                2A,01, \
                                34,02, 35,02, \
                                37,01, 38,01, \
                                22,01, 23,05, 24,01, 25,01
HKR,Parameters,SdAppCmdFlags,1, 06,01, 0D,01, 16,01, 17,01, 33,01, \
                                12,01, 19,01, 1A,01, 26,01, 2B,01, \
                                2C,01, 2D,01, 2E,01, 2F,01, 30,01, 31,01

[DriverCopyFiles]
mtkmsdc.sys

[ControlFlags]
ExcludeFromSelect=*

[Strings]
ProviderName="Barley Windows Enablement"
ManufacturerName="MediaTek"
DiskName="Barley MT6768 MSDC driver package"
Msdc.DeviceDesc="MediaTek MT6768 MSDC storage host controller"
Msdc.ServiceDesc="MediaTek MT6768 MSDC SDPORT miniport"
SlotDescription="MSDC controller %1!u!"
